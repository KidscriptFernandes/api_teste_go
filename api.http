@baseUrl = http://localhost:8080

### Health check
GET {{baseUrl}}/healthz

### Create a user
# @name createUser
POST {{baseUrl}}/api/v1/users
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "ada-{{$guid}}@example.com"
}

### List users
GET {{baseUrl}}/api/v1/users?limit=10&offset=0

### Get the user created above
GET {{baseUrl}}/api/v1/users/{{createUser.response.body.$.id}}

### Update the user created above
PUT {{baseUrl}}/api/v1/users/{{createUser.response.body.$.id}}
Content-Type: application/json

{
  "name": "Ada Byron",
  "email": "ada-byron-{{$guid}}@example.com"
}

### Delete the user created above
DELETE {{baseUrl}}/api/v1/users/{{createUser.response.body.$.id}}
